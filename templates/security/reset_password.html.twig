<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Réinitialisation du mot de passe - LibraryHub</title>
    <link rel="shortcut icon" href="{{ asset('assets/images/favicon.ico') }}"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet"/>
    <link rel="stylesheet" href="{{ asset('assets/vendor/font-awesome/css/all.min.css') }}"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: { extend: { colors: { "primary": "#1754cf", "gold-accent": "#D4AF37" }, fontFamily: { "display": ["Manrope","sans-serif"], "serif": ["Playfair Display","serif"] } } }
        }
    </script>
    <style>
        .glass-effect { background: rgba(255,255,255,0.7); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.3); }
        .gold-gradient-icon { background: linear-gradient(135deg,#D4AF37 0%,#F9E498 50%,#B8860B 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        body { font-family: 'Manrope', sans-serif; }
    </style>
</head>
<body class="font-display bg-[#f6f6f8] text-slate-800 min-h-screen flex items-center justify-center">

<div class="w-full max-w-md px-4 z-10">
    <div class="glass-effect p-10 rounded-xl shadow-2xl border border-white/40">
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-white rounded-full shadow-inner mb-4">
                <span class="material-icons-round text-3xl gold-gradient-icon">key</span>
            </div>
            <h2 class="text-3xl font-serif font-bold text-slate-900 mb-2">Nouveau mot de passe</h2>
            <p class="text-slate-500 text-sm">Choisissez un mot de passe sécurisé (8 caractères minimum).</p>
        </div>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 p-4 rounded-lg
                    {% if label == 'success' %}bg-green-50 border border-green-200 text-green-800
                    {% else %}bg-red-50 border border-red-200 text-red-800{% endif %}
                    text-sm" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <form method="post" action="{{ path('app_reset_password', {token: token}) }}" class="space-y-5" id="resetForm" novalidate>

            {# New password #}
            <div class="relative group">
                <input type="password"
                       name="password"
                       id="newPassword"
                       class="peer w-full px-4 pt-6 pb-2 bg-white/50 border border-slate-200 rounded-lg
                              focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none"
                       placeholder=" "
                       autocomplete="new-password"
                       required/>
                <label class="absolute left-4 top-4 text-slate-400 pointer-events-none transition-all duration-200 origin-left
                              peer-focus:-translate-y-3 peer-focus:scale-75 peer-focus:text-primary
                              peer-[:not(:placeholder-shown)]:-translate-y-3 peer-[:not(:placeholder-shown)]:scale-75"
                       for="newPassword">Nouveau mot de passe</label>
                <button type="button" id="toggleNew"
                        class="absolute right-4 top-4 text-slate-300 hover:text-slate-500 transition-colors focus:outline-none">
                    <span class="material-icons-round text-xl">visibility</span>
                </button>
                <div id="newPasswordError" class="mt-1 text-sm text-red-600 hidden"></div>
            </div>

            {# Strength bar #}
            <div class="space-y-1">
                <div class="h-1.5 w-full bg-slate-200 rounded-full overflow-hidden">
                    <div id="strengthBar" class="h-full rounded-full transition-all duration-300 w-0 bg-red-400"></div>
                </div>
                <p id="strengthText" class="text-xs text-slate-400"></p>
            </div>

            {# Confirm password #}
            <div class="relative group">
                <input type="password"
                       name="confirm_password"
                       id="confirmPassword"
                       class="peer w-full px-4 pt-6 pb-2 bg-white/50 border border-slate-200 rounded-lg
                              focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none"
                       placeholder=" "
                       autocomplete="new-password"
                       required/>
                <label class="absolute left-4 top-4 text-slate-400 pointer-events-none transition-all duration-200 origin-left
                              peer-focus:-translate-y-3 peer-focus:scale-75 peer-focus:text-primary
                              peer-[:not(:placeholder-shown)]:-translate-y-3 peer-[:not(:placeholder-shown)]:scale-75"
                       for="confirmPassword">Confirmer le mot de passe</label>
                <button type="button" id="toggleConfirm"
                        class="absolute right-4 top-4 text-slate-300 hover:text-slate-500 transition-colors focus:outline-none">
                    <span class="material-icons-round text-xl">visibility</span>
                </button>
                <div id="confirmPasswordError" class="mt-1 text-sm text-red-600 hidden"></div>
            </div>

            <button type="submit"
                    class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-lg shadow-lg transition-all transform active:scale-[0.98]">
                Réinitialiser le mot de passe
            </button>
        </form>

        <div class="mt-6 text-center">
            <a href="{{ path('app_login') }}" class="text-primary text-sm font-semibold hover:underline decoration-2 underline-offset-4">
                ← Retour à la connexion
            </a>
        </div>
    </div>
</div>

<script>
(function () {
    function toggleVisibility(btnId, inputId) {
        document.getElementById(btnId).addEventListener('click', function () {
            var input = document.getElementById(inputId);
            var icon  = this.querySelector('.material-icons-round');
            input.type = input.type === 'password' ? 'text' : 'password';
            icon.textContent = input.type === 'password' ? 'visibility' : 'visibility_off';
        });
    }
    toggleVisibility('toggleNew', 'newPassword');
    toggleVisibility('toggleConfirm', 'confirmPassword');

    // Strength meter
    document.getElementById('newPassword').addEventListener('input', function () {
        var val = this.value;
        var score = 0;
        if (val.length >= 8)  score++;
        if (/[A-Z]/.test(val)) score++;
        if (/[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;

        var bar  = document.getElementById('strengthBar');
        var text = document.getElementById('strengthText');
        var levels = [
            { pct: '0%',   color: 'bg-red-400',    label: '' },
            { pct: '25%',  color: 'bg-red-400',    label: 'Très faible' },
            { pct: '50%',  color: 'bg-orange-400', label: 'Faible' },
            { pct: '75%',  color: 'bg-yellow-400', label: 'Moyen' },
            { pct: '100%', color: 'bg-green-500',  label: 'Fort' },
        ];
        bar.style.width = levels[score].pct;
        bar.className   = 'h-full rounded-full transition-all duration-300 ' + levels[score].color;
        text.textContent = levels[score].label;
    });

    // Client-side validation
    document.getElementById('resetForm').addEventListener('submit', function (e) {
        var pwd  = document.getElementById('newPassword').value;
        var conf = document.getElementById('confirmPassword').value;
        var ok   = true;

        var errNew  = document.getElementById('newPasswordError');
        var errConf = document.getElementById('confirmPasswordError');
        errNew.classList.add('hidden');
        errConf.classList.add('hidden');

        if (pwd.length < 8) {
            errNew.textContent = 'Le mot de passe doit contenir au moins 8 caractères.';
            errNew.classList.remove('hidden');
            ok = false;
        }
        if (pwd !== conf) {
            errConf.textContent = 'Les mots de passe ne correspondent pas.';
            errConf.classList.remove('hidden');
            ok = false;
        }
        if (!ok) e.preventDefault();
    });
})();
</script>
</body>
</html>
