<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Mot de passe oublié - LibraryHub</title>
    <link rel="shortcut icon" href="{{ asset('assets/images/favicon.ico') }}"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet"/>
    <link rel="stylesheet" href="{{ asset('assets/vendor/font-awesome/css/all.min.css') }}"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: { extend: { colors: { "primary": "#1754cf", "gold-accent": "#D4AF37" }, fontFamily: { "display": ["Manrope","sans-serif"], "serif": ["Playfair Display","serif"] } } }
        }
    </script>
    <style>
        .glass-effect { background: rgba(255,255,255,0.7); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.3); }
        .gold-gradient-icon { background: linear-gradient(135deg,#D4AF37 0%,#F9E498 50%,#B8860B 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        body { font-family: 'Manrope', sans-serif; }
    </style>
</head>
<body class="font-display bg-[#f6f6f8] text-slate-800 min-h-screen flex items-center justify-center">

<div class="w-full max-w-md px-4 z-10">
    <div class="glass-effect p-10 rounded-xl shadow-2xl border border-white/40">
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-white rounded-full shadow-inner mb-4">
                <span class="material-icons-round text-3xl gold-gradient-icon">lock_reset</span>
            </div>
            <h2 class="text-3xl font-serif font-bold text-slate-900 mb-2">Mot de passe oublié</h2>
            <p class="text-slate-500 text-sm">Entrez votre e-mail, nous vous enverrons un lien de réinitialisation.</p>
        </div>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 p-4 rounded-lg
                    {% if label == 'success' %}bg-green-50 border border-green-200 text-green-800
                    {% else %}bg-red-50 border border-red-200 text-red-800{% endif %}
                    text-sm" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <form method="post" action="{{ path('app_forgot_password') }}" class="space-y-5" novalidate>
            <div class="relative group">
                <input type="email"
                       name="email"
                       id="inputEmail"
                       class="peer w-full px-4 pt-6 pb-2 bg-white/50 border border-slate-200 rounded-lg
                              focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none"
                       placeholder=" "
                       autocomplete="email"
                       required/>
                <label class="absolute left-4 top-4 text-slate-400 pointer-events-none transition-all duration-200 origin-left
                              peer-focus:-translate-y-3 peer-focus:scale-75 peer-focus:text-primary
                              peer-[:not(:placeholder-shown)]:-translate-y-3 peer-[:not(:placeholder-shown)]:scale-75"
                       for="inputEmail">Adresse e-mail</label>
                <span class="material-icons-round absolute right-4 top-4 text-slate-300 group-focus-within:text-primary transition-colors">alternate_email</span>
            </div>

            <button type="submit"
                    class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-lg shadow-lg transition-all transform active:scale-[0.98]">
                Envoyer le lien de réinitialisation
            </button>
        </form>

        <div class="mt-6 text-center">
            <a href="{{ path('app_login') }}" class="text-primary text-sm font-semibold hover:underline decoration-2 underline-offset-4">
                ← Retour à la connexion
            </a>
        </div>
    </div>
</div>

</body>
</html>
