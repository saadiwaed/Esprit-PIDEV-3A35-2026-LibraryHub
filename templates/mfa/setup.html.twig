<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Configuration MFA - LibraryHub</title>
    <link rel="shortcut icon" href="{{ asset('assets/images/favicon.ico') }}"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet"/>
    <link rel="stylesheet" href="{{ asset('assets/vendor/font-awesome/css/all.min.css') }}"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#1754cf",
                        "background-light": "#f6f6f8",
                        "background-dark": "#111621",
                        "gold-accent": "#D4AF37",
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"],
                        "serif": ["Playfair Display", "serif"],
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style>
        .glass-effect {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        .gold-gradient-icon {
            background: linear-gradient(135deg, #D4AF37 0%, #F9E498 50%, #B8860B 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        body { font-family: 'Manrope', sans-serif; }

        /* Security shield pulse animation */
        @keyframes shield-pulse {
            0%, 100% { transform: scale(1); opacity: 0.15; }
            50% { transform: scale(1.08); opacity: 0.25; }
        }
        @keyframes ring-expand {
            0% { transform: scale(0.8); opacity: 0.6; }
            100% { transform: scale(1.6); opacity: 0; }
        }
        @keyframes float-up {
            0% { transform: translateY(20px); opacity: 0; }
            100% { transform: translateY(0); opacity: 1; }
        }
        @keyframes digit-blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }
        @keyframes lock-open {
            0%, 80%, 100% { transform: rotate(0deg); }
            40% { transform: rotate(-15deg); }
        }
        .shield-pulse { animation: shield-pulse 3s ease-in-out infinite; }
        .ring-1 { animation: ring-expand 2.5s ease-out infinite; }
        .ring-2 { animation: ring-expand 2.5s ease-out infinite 0.8s; }
        .ring-3 { animation: ring-expand 2.5s ease-out infinite 1.6s; }
        .float-in { animation: float-up 0.7s ease-out both; }
        .float-in-1 { animation: float-up 0.7s ease-out 0.1s both; }
        .float-in-2 { animation: float-up 0.7s ease-out 0.2s both; }
        .float-in-3 { animation: float-up 0.7s ease-out 0.3s both; }
        .digit-active { animation: digit-blink 1s ease-in-out infinite; }
        .lock-anim { animation: lock-open 3s ease-in-out infinite; }

        /* OTP input styling */
        .otp-input {
            width: 3rem;
            height: 3.5rem;
            text-align: center;
            font-size: 1.5rem;
            font-weight: 700;
            border: 2px solid #e2e8f0;
            border-radius: 0.5rem;
            background: rgba(255,255,255,0.6);
            transition: all 0.2s;
            outline: none;
            caret-color: #1754cf;
        }
        .otp-input:focus {
            border-color: #1754cf;
            box-shadow: 0 0 0 3px rgba(23,84,207,0.15);
            background: white;
        }
        .otp-input.filled {
            border-color: #1754cf;
            background: rgba(23,84,207,0.05);
            color: #1754cf;
        }
        .otp-input.error {
            border-color: #ef4444;
            background: rgba(239,68,68,0.05);
        }

        /* Step indicator */
        .step-done { background: #1754cf; color: white; }
        .step-active { background: #1754cf; color: white; box-shadow: 0 0 0 4px rgba(23,84,207,0.2); }
        .step-pending { background: #e2e8f0; color: #94a3b8; }

        /* Secret code copy effect */
        .copy-btn:active { transform: scale(0.95); }
    </style>
</head>
<body class="font-display bg-[#f6f6f8] text-slate-800 min-h-screen overflow-hidden">
<main class="flex min-h-screen w-full">

    <!-- ═══════════════════════════════════════════
         LEFT — Security themed visual panel
         (Only this side changes from login/register)
    ════════════════════════════════════════════ -->
    <section class="hidden lg:flex lg:w-3/5 relative overflow-hidden" style="background: linear-gradient(135deg, #0a1628 0%, #111e3a 50%, #0d1f4a 100%);">

        <!-- Animated background grid -->
        <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(23,84,207,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(23,84,207,0.4) 1px, transparent 1px); background-size: 40px 40px;"></div>

        <!-- Glowing orbs -->
        <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2">
            <!-- Expanding rings -->
            <div class="ring-1 absolute inset-0 w-80 h-80 -translate-x-1/2 -translate-y-1/2 left-1/2 top-1/2 rounded-full border border-blue-400/30"></div>
            <div class="ring-2 absolute inset-0 w-80 h-80 -translate-x-1/2 -translate-y-1/2 left-1/2 top-1/2 rounded-full border border-blue-400/20"></div>
            <div class="ring-3 absolute inset-0 w-80 h-80 -translate-x-1/2 -translate-y-1/2 left-1/2 top-1/2 rounded-full border border-blue-400/10"></div>

            <!-- Central shield -->
            <div class="relative flex items-center justify-center w-48 h-48">
                <div class="shield-pulse absolute inset-0 bg-blue-500 rounded-full blur-3xl"></div>
                <div class="relative z-10 flex flex-col items-center">
                    <span class="material-icons-round text-8xl text-blue-400 lock-anim drop-shadow-2xl" style="text-shadow: 0 0 40px rgba(96,165,250,0.6);">shield</span>
                </div>
            </div>
        </div>

        <!-- Floating security badges -->
        <div class="float-in-1 absolute top-28 left-20 flex items-center gap-3 px-4 py-3 rounded-xl" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(8px);">
            <span class="material-icons-round text-green-400 text-xl">verified_user</span>
            <div>
                <p class="text-white text-xs font-bold">Chiffrement AES-256</p>
                <p class="text-blue-300 text-xs">Données sécurisées</p>
            </div>
        </div>

        <div class="float-in-2 absolute top-52 right-16 flex items-center gap-3 px-4 py-3 rounded-xl" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(8px);">
            <span class="material-icons-round text-amber-400 text-xl">smartphone</span>
            <div>
                <p class="text-white text-xs font-bold">Authentification 2FA</p>
                <p class="text-blue-300 text-xs">TOTP RFC 6238</p>
            </div>
        </div>

        <div class="float-in-3 absolute bottom-64 left-16 flex items-center gap-3 px-4 py-3 rounded-xl" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(8px);">
            <span class="material-icons-round text-purple-400 text-xl">lock_clock</span>
            <div>
                <p class="text-white text-xs font-bold">Code valide 30s</p>
                <p class="text-blue-300 text-xs">Rotation automatique</p>
            </div>
        </div>

        <!-- Animated OTP display -->
        <div class="float-in absolute bottom-44 right-12 px-5 py-4 rounded-xl" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(8px);">
            <p class="text-blue-300 text-xs font-bold mb-2 uppercase tracking-widest">Code de démonstration</p>
            <div class="flex gap-2">
                <span class="w-8 h-10 flex items-center justify-center rounded bg-blue-500/20 border border-blue-400/30 text-blue-300 font-mono font-bold text-lg">4</span>
                <span class="w-8 h-10 flex items-center justify-center rounded bg-blue-500/20 border border-blue-400/30 text-blue-300 font-mono font-bold text-lg">8</span>
                <span class="w-8 h-10 flex items-center justify-center rounded bg-blue-500/20 border border-blue-400/30 text-blue-300 font-mono font-bold text-lg">3</span>
                <span class="w-8 h-10 flex items-center justify-center rounded bg-blue-500/20 border border-blue-400/30 text-blue-300 font-mono font-bold text-lg digit-active">_</span>
                <span class="w-8 h-10 flex items-center justify-center rounded bg-white/5 border border-white/10 text-slate-600 font-mono font-bold text-lg">·</span>
                <span class="w-8 h-10 flex items-center justify-center rounded bg-white/5 border border-white/10 text-slate-600 font-mono font-bold text-lg">·</span>
            </div>
        </div>

        <!-- Top logo -->
        <div class="relative z-20 flex flex-col justify-between p-16 h-full text-white w-full">
            <div>
                <a href="{{ path('app_frontoffice') }}" class="inline-flex items-center gap-2 mb-8 no-underline text-white hover:opacity-90 transition-opacity">
                    <i class="fas fa-book-open text-2xl" style="color: #1754cf;"></i>
                    <span class="text-2xl font-bold tracking-tight"><span class="text-white">LIBRARY</span><span class="text-amber-300">HUB</span></span>
                </a>
                <h1 class="text-5xl font-serif max-w-xl leading-tight mt-16">
                    Sécurisez votre<br/><span class="italic text-blue-300">accès</span> en 3 étapes.
                </h1>
                <p class="text-white/60 mt-4 text-lg font-light max-w-sm leading-relaxed">
                    La double authentification protège votre compte même si votre mot de passe est compromis.
                </p>
            </div>

            <!-- Steps progress -->
            <div class="max-w-sm">
                <p class="text-xs uppercase tracking-widest text-blue-300 font-bold mb-4">Étapes de configuration</p>
                <div class="space-y-3">
                    <div class="flex items-center gap-4">
                        <span class="step-done w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0">
                            <span class="material-icons-round text-sm">check</span>
                        </span>
                        <div>
                            <p class="text-white text-sm font-semibold">Compte créé</p>
                            <p class="text-white/40 text-xs">Inscription réussie</p>
                        </div>
                    </div>
                    <div class="ml-3 w-px h-4 bg-blue-500/40"></div>
                    <div class="flex items-center gap-4">
                        <span class="step-active w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0">2</span>
                        <div>
                            <p class="text-white text-sm font-semibold">Configuration 2FA</p>
                            <p class="text-blue-300 text-xs">En cours — scannez le QR code</p>
                        </div>
                    </div>
                    <div class="ml-3 w-px h-4 bg-white/10"></div>
                    <div class="flex items-center gap-4">
                        <span class="step-pending w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0">3</span>
                        <div>
                            <p class="text-white/40 text-sm font-semibold">Accès sécurisé</p>
                            <p class="text-white/20 text-xs">Connexion à votre espace</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════
         RIGHT — MFA setup form (same as login/register)
    ════════════════════════════════════════════ -->
    <section class="w-full lg:w-2/5 flex flex-col items-center justify-center p-8 bg-[#f6f6f8] relative min-h-screen overflow-y-auto">
        <div class="absolute top-20 right-20 w-32 h-32 bg-primary/5 rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 left-20 w-48 h-48 bg-primary/10 rounded-full blur-3xl"></div>

        <div class="w-full max-w-md z-10 py-8">
            <div class="glass-effect p-10 rounded-xl shadow-2xl border border-white/40">

                <!-- Header -->
                <div class="text-center mb-8">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-white rounded-full shadow-inner mb-4">
                        <span class="material-icons-round text-3xl gold-gradient-icon">security</span>
                    </div>
                    <h2 class="text-3xl font-serif font-bold text-slate-900 mb-2">Double authentification</h2>
                    <p class="text-slate-500 font-medium text-sm">Scannez le QR code avec votre application d'authentification</p>
                </div>

                <!-- Flash messages -->
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="mb-4 p-4 rounded-lg {% if label == 'error' %}bg-red-50 border border-red-200 text-red-800{% else %}bg-green-50 border border-green-200 text-green-800{% endif %} text-sm flex items-start gap-2" role="alert">
                            <span class="material-icons-round text-base mt-0.5">{% if label == 'error' %}error_outline{% else %}check_circle_outline{% endif %}</span>
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <!-- QR Code -->
                <div class="flex flex-col items-center mb-6">
                    <div class="bg-white p-4 rounded-xl shadow-inner border border-slate-100 mb-3">
                        {{ qrCodeSvg|raw }}
                    </div>
                    <p class="text-xs text-slate-400 text-center">Utilisez <span class="font-semibold text-slate-600">Google Authenticator</span>, <span class="font-semibold text-slate-600">Authy</span> ou <span class="font-semibold text-slate-600">Microsoft Authenticator</span></p>
                </div>

                <!-- Manual secret -->
                <div class="mb-6 p-4 rounded-lg bg-slate-50 border border-slate-200">
                    <p class="text-xs text-slate-500 mb-2 font-semibold uppercase tracking-wider">Ou saisissez manuellement</p>
                    <div class="flex items-center gap-2">
                        <code class="flex-1 font-mono text-sm text-primary font-bold tracking-widest break-all" id="secretCode">{{ secret }}</code>
                        <button type="button" id="copyBtn" class="copy-btn flex-shrink-0 p-2 rounded-lg bg-white border border-slate-200 hover:border-primary hover:text-primary transition-all text-slate-400" title="Copier">
                            <span class="material-icons-round text-base" id="copyIcon">content_copy</span>
                        </button>
                    </div>
                </div>

                <!-- OTP Form -->
                <form method="POST" id="mfaForm">
                    <input type="hidden" name="secret" value="{{ secret }}">

                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-slate-700 mb-3 text-center">
                            Entrez le code à 6 chiffres affiché dans votre application
                        </label>

                        <!-- OTP digit boxes -->
                        <div class="flex justify-center gap-2 mb-2" id="otpBoxes">
                            <input type="text" inputmode="numeric" maxlength="1" class="otp-input" data-index="0" autofocus/>
                            <input type="text" inputmode="numeric" maxlength="1" class="otp-input" data-index="1"/>
                            <input type="text" inputmode="numeric" maxlength="1" class="otp-input" data-index="2"/>
                            <span class="flex items-center text-slate-300 font-bold text-xl">—</span>
                            <input type="text" inputmode="numeric" maxlength="1" class="otp-input" data-index="3"/>
                            <input type="text" inputmode="numeric" maxlength="1" class="otp-input" data-index="4"/>
                            <input type="text" inputmode="numeric" maxlength="1" class="otp-input" data-index="5"/>
                        </div>
                        <!-- Hidden real input that gets submitted -->
                        <input type="hidden" name="code" id="hiddenCode"/>
                        <p class="text-center text-xs text-slate-400 mt-2" id="codeHint">Le code se renouvelle toutes les 30 secondes</p>
                    </div>

                    <!-- Countdown timer -->
                    <div class="flex items-center justify-center gap-2 mb-6">
                        <div class="relative w-8 h-8">
                            <svg class="w-8 h-8 -rotate-90" viewBox="0 0 32 32">
                                <circle cx="16" cy="16" r="13" fill="none" stroke="#e2e8f0" stroke-width="3"/>
                                <circle cx="16" cy="16" r="13" fill="none" stroke="#1754cf" stroke-width="3"
                                        stroke-dasharray="81.68" id="timerCircle"
                                        stroke-linecap="round" style="transition: stroke-dashoffset 1s linear;"/>
                            </svg>
                            <span class="absolute inset-0 flex items-center justify-center text-xs font-bold text-primary" id="timerText">30</span>
                        </div>
                        <span class="text-xs text-slate-500">secondes restantes</span>
                    </div>

                    <button type="submit" id="submitBtn"
                            class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-lg shadow-lg transition-all transform active:scale-[0.98] flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                        <span class="material-icons-round text-xl">lock_open</span>
                        Vérifier et activer
                    </button>
                </form>
            </div>

            <!-- Footer -->
            <div class="mt-6 text-center">
                <p class="text-slate-500 text-sm">
                    Besoin d'aide ?
                    <a class="text-primary font-bold hover:underline decoration-2 underline-offset-4 ml-1" href="#">Support</a>
                </p>
                <div class="mt-4 flex items-center justify-center gap-6">
                    <a class="text-xs font-bold text-slate-400 hover:text-slate-600 uppercase tracking-widest transition-colors" href="#">Mentions légales</a>
                    <span class="w-1 h-1 bg-slate-300 rounded-full"></span>
                    <a class="text-xs font-bold text-slate-400 hover:text-slate-600 uppercase tracking-widest transition-colors" href="#">Confidentialité</a>
                </div>
            </div>
        </div>
    </section>
</main>

<script>
(function () {
    // ── OTP digit boxes ──────────────────────────────────────────
    const boxes   = Array.from(document.querySelectorAll('.otp-input'));
    const hidden  = document.getElementById('hiddenCode');
    const form    = document.getElementById('mfaForm');
    const hint    = document.getElementById('codeHint');

    function updateHidden() {
        hidden.value = boxes.map(b => b.value).join('');
    }

    boxes.forEach((box, i) => {
        box.addEventListener('input', e => {
            const val = e.target.value.replace(/\D/g, '');
            box.value = val ? val[val.length - 1] : '';
            box.classList.toggle('filled', !!box.value);
            updateHidden();
            if (box.value && i < boxes.length - 1) boxes[i + 1].focus();
        });

        box.addEventListener('keydown', e => {
            if (e.key === 'Backspace' && !box.value && i > 0) {
                boxes[i - 1].value = '';
                boxes[i - 1].classList.remove('filled');
                boxes[i - 1].focus();
                updateHidden();
            }
            if (e.key === 'ArrowLeft' && i > 0) boxes[i - 1].focus();
            if (e.key === 'ArrowRight' && i < boxes.length - 1) boxes[i + 1].focus();
        });

        // Handle paste on any box
        box.addEventListener('paste', e => {
            e.preventDefault();
            const pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
            pasted.split('').slice(0, 6).forEach((ch, j) => {
                if (boxes[j]) {
                    boxes[j].value = ch;
                    boxes[j].classList.add('filled');
                }
            });
            updateHidden();
            const next = Math.min(pasted.length, 5);
            boxes[next].focus();
        });
    });

    form.addEventListener('submit', e => {
        updateHidden();
        const code = hidden.value;
        if (code.length !== 6) {
            e.preventDefault();
            boxes.forEach(b => b.classList.add('error'));
            hint.textContent = '⚠ Veuillez entrer les 6 chiffres complets.';
            hint.classList.add('text-red-500');
            hint.classList.remove('text-slate-400');
            boxes[0].focus();
        }
    });

    // ── Countdown timer ──────────────────────────────────────────
    const timerText   = document.getElementById('timerText');
    const timerCircle = document.getElementById('timerCircle');
    const circumference = 81.68;

    function updateTimer() {
        const now  = Math.floor(Date.now() / 1000);
        const secs = 30 - (now % 30);
        const pct  = secs / 30;

        timerText.textContent = secs;
        timerCircle.style.strokeDashoffset = circumference * (1 - pct);

        if (secs <= 5) {
            timerCircle.style.stroke = '#ef4444';
            timerText.style.color    = '#ef4444';
        } else {
            timerCircle.style.stroke = '#1754cf';
            timerText.style.color    = '#1754cf';
        }
    }
    updateTimer();
    setInterval(updateTimer, 1000);

    // ── Copy secret ──────────────────────────────────────────────
    const copyBtn  = document.getElementById('copyBtn');
    const copyIcon = document.getElementById('copyIcon');

    copyBtn.addEventListener('click', () => {
        const secret = document.getElementById('secretCode').textContent.trim();
        navigator.clipboard.writeText(secret).then(() => {
            copyIcon.textContent = 'check';
            copyBtn.classList.add('text-green-500', 'border-green-300');
            setTimeout(() => {
                copyIcon.textContent = 'content_copy';
                copyBtn.classList.remove('text-green-500', 'border-green-300');
            }, 2000);
        });
    });
})();
</script>
</body>
</html>
